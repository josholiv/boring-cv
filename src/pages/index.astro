---
import '../styles/cv.css';
import cv from '../data/cv.json';
const { basics, education, work, publications, presentations, researchExperience, awards, skills } = cv;

function formatDate(str) {
  if (!str) return '';
  const d = new Date(str);
  return `${d.toLocaleString('default', { month: 'short' })} ${d.getFullYear()}`;
}
---
<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <title>{basics.name} – CV</title>
    <meta name='viewport' content='width=device-width, initial-scale=1' />
  </head>

  <body>
    <div class="cv-container">
      <h1>{basics.name}</h1>
      <h2>Personal Information</h2>
      <hr />
      {basics.location.address} <br />
      {basics.location.city}, {basics.location.postalCode}<br />
      {basics.email}<br />
      {basics.phone}<br />
      {basics.url}

      <section>
        <h2>Education</h2>
        <hr />
        {education.map(ed => (
          <div class="section-item">
            <strong>{ed.institution}</strong>, {ed.area} ({ed.studyType})<br />
            {formatDate(ed.startDate)} – {formatDate(ed.endDate)}
          </div>
        ))}
      </section>

      <section>
        <h2>Publications</h2>
        <hr />
        <div>
          {publications.map(pub => (
            <div class="apa-entry">
              <Fragment set:html={pub.authors.replace(/Doe, J\./g, "<strong>Doe, J.</strong>")} />
              ({pub.year}). {pub.name}. <em>{pub.publisher}</em>. <a href={pub.url} target="_blank">{pub.url}</a>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2>Presentations</h2>
        <hr />
        <div>
          {presentations.map(pres => (
            <div class="apa-entry">
              <Fragment set:html={pres.authors.replace(/Doe, J\./g, "<strong>Doe, J.</strong>")} />
              ({pres.year}, {pres.dateRange}). <i>{pres.name}</i> [{pres.type}]. {pres.conference}, {pres.location}. <a href={pres.url} target="_blank">{pres.url}</a>
            </div>
          ))}
        </div>
        <div>
          *Presenter
        </div>
      </section>

     <section>
        <h2>Research Experience</h2>
        <hr />
        {researchExperience.map(res => (
          <div class="section-item experience-entry">
            <div class="experience-header">
              <div><strong>{res.lab}</strong>, {res.institution}</div>
              <span class="date-range">{formatDate(res.startDate)} – {formatDate(res.endDate)}</span>
            </div>
            <div>Mentor: {res.mentor}</div>
            <div>Title: {res.title}</div>
            <ul class="two-column-list">
              {res.roles.map((role, index) => (
                <li key={index}>{role}</li>
              ))}
            </ul>
          </div>
        ))}
      </section>



      <section>
        <h2>Teaching Experience</h2>
        <hr />
      </section>

      <section>
        <h2>Grants &amp; Fellowships</h2>
        <hr />
      </section>

      <section>
        <h2>Honors &amp; Awards</h2>
        <hr />
        <ul>
          {awards.map(a => (
            <li class="section-item">
              {a.title}, {a.awarder} – {formatDate(a.date)}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Professional Memberships</h2>
        <hr />
      </section>

      <section>
        <h2>Skills</h2>
        <hr />
        <p>{skills.map(s => s.name).join(', ')}</p>
      </section>
    </div>
  </body>
</html>
